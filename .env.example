# Base URL of tl-api, with no trailing slash and no /api suffix
# (the app appends /api/... itself).
# Local:      http://localhost:5000
# Production: set this in Amplify (app d3p1aksfaupd6l, region eu-north-1)
VITE_API_URL=http://localhost:5000

# Stripe publishable key (pk_test_… / pk_live_…). Public by design — it ships in
# the browser bundle. Must belong to the same Stripe account as the API's
# STRIPE_SECRET_KEY, or payments fail with an account mismatch.
# Production: set this in Amplify (app d3p1aksfaupd6l, region eu-north-1)
VITE_STRIPE_PUBLISHABLE_KEY=
